# Google AI Studio (https://aistudio.google.com/apikey) で発行したAPIキー
GEMINI_API_KEY=ここにAPIキーを貼る

# 使うモデル（省略時は gemini-3.1-flash-lite）
# GEMINI_MODEL=gemini-3.1-flash-lite

# ネット公開時の合言葉。ローカルだけなら空でOK。
# APP_PASSCODE=

# -----------------------------------------------------------------------------
# Aivis Cloud（任意 / server-side only）
# -----------------------------------------------------------------------------
# CURRENT公式仕様: POST https://api.aivis-project.com/v1/tts/synthesize
# Bearer API key。実際のmodel UUID / style名はAivis側の対象モデル画面で確認してください。
# 未設定・未承認のキャラは文字会話だけで安全に動作します。
# AIVIS_API_KEY=

# キャラごとに以下の TOKEN を使います:
# AIMI / SHIZUKU / NAGI / HINATA / RENA
#
# productionApprovedにするには、MODEL_UUIDだけでなく以下のライセンス確認項目を
# すべて埋め、最後に PRODUCTION_APPROVED_<TOKEN>=true を明示してください。
# 不明な値を推測して埋めないでください。
#
# AIVIS_VOICE_PROFILE_ID_SHIZUKU=aivis:shizuku:<reviewed-name>
# AIVIS_MODEL_UUID_SHIZUKU=
# AIVIS_PRODUCTION_APPROVED_SHIZUKU=false
# AIVIS_LICENSE_URL_SHIZUKU=
# AIVIS_LICENSE_COMMERCIAL_SCOPE_SHIZUKU=
# AIVIS_LICENSE_OTHER_CHARACTER_USE_SHIZUKU=
# AIVIS_LICENSE_REVIEWED_AT_SHIZUKU=2026-08-30
# AIVIS_ATTRIBUTION_REQUIRED_SHIZUKU=false
# AIVIS_ATTRIBUTION_TEXT_SHIZUKU=
# AIVIS_LICENSE_CONTENT_RESTRICTIONS_SHIZUKU=
# AIVIS_LICENSE_REDISTRIBUTION_RESTRICTIONS_SHIZUKU=
#
# Aivisのstyle_nameはモデルごとに異なります。公式モデル情報で確認できたものだけ設定。
# AIVIS_STYLE_NEUTRAL_SHIZUKU=
# AIVIS_STYLE_BRIGHT_SHIZUKU=
# AIVIS_STYLE_SOFT_SHIZUKU=
# AIVIS_STYLE_SHY_SHIZUKU=
# AIVIS_STYLE_SAD_SHIZUKU=
# AIVIS_STYLE_SERIOUS_SHIZUKU=
# AIVIS_STYLE_EXCITED_SHIZUKU=
#
# primaryが失敗したときのfallbackも、productionApproved済みprofileだけ指定可能。
# AIVIS_FALLBACK_VOICE_PROFILE_ID_SHIZUKU=
#
# 他4キャラも同じsuffixを TOKEN だけ置き換えて設定します。
